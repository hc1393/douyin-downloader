/* 登录页面样式 */
.container {
  display: flex;
  flex-direction: column;
  padding: 0 80rpx;
  background-color: #f8f8f8;
  height: 100vh;
}

.header {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 120rpx;
  margin-bottom: 80rpx;
}

.logo {
  width: 160rpx;
  height: 160rpx;
  margin-bottom: 30rpx;
}

.title {
  font-size: 48rpx;
  color: #333;
  font-weight: bold;
}

.input-group {
  background-color: #fff;
  border-radius: 10rpx;
  padding: 0 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
}

.input-item {
  display: flex;
  align-items: center;
  height: 100rpx;
  border-bottom: 1rpx solid #eee;
}

.input-item:last-child {
  border-bottom: none;
}

.icon {
  width: 40rpx;
  height: 40rpx;
  margin-right: 20rpx;
}

.input {
  flex: 1;
  font-size: 32rpx;
}

.placeholder {
  color: #ccc;
}

.eye-icon {
  width: 40rpx;
  height: 40rpx;
  margin-left: 20rpx;
}

.options {
  display: flex;
  justify-content: space-between;
  margin-top: 20rpx;
}

.remember-password, .auto-login {
  display: flex;
  align-items: center;
}

.option-text {
  font-size: 28rpx;
  color: #666;
  margin-left: 10rpx;
}

.login-btn {
  margin-top: 50rpx;
  background-color: #00bfff;
  color: white;
  border-radius: 50rpx;
  font-size: 36rpx;
  height: 90rpx;
  line-height: 90rpx;
  width: 100%;
}

.login-btn::after {
  border: none;
}

.footer {
  display: flex;
  justify-content: space-between;
  margin-top: 30rpx;
}

.link {
  color: #00bfff;
  font-size: 28rpx;
}

.third-party-login {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 100rpx;
}

.divider {
  position: relative;
  color: #999;
  font-size: 24rpx;
}

.divider::before {
  content: "";
  position: absolute;
  left: -120rpx;
  top: 50%;
  width: 100rpx;
  height: 1rpx;
  background-color: #ddd;
}

.divider::after {
  content: "";
  position: absolute;
  right: -120rpx;
  top: 50%;
  width: 100rpx;
  height: 1rpx;
  background-color: #ddd;
}

.icons {
  display: flex;
  margin-top: 30rpx;
}

.third-btn {
  background: transparent;
  border: none;
  padding: 0;
  margin: 0 30rpx;
}

.third-btn::after {
  border: none;
}

.third-icon {
  width: 70rpx;
  height: 70rpx;
}