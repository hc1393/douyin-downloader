/* 忘记密码页面样式 */
.container {
  display: flex;
  flex-direction: column;
  padding: 0 80rpx;
  background-color: #f8f8f8;
  height: 100vh;
}

.header {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 100rpx;
  margin-bottom: 60rpx;
}

.logo {
  width: 120rpx;
  height: 120rpx;
  margin-bottom: 20rpx;
}

.title {
  font-size: 42rpx;
  color: #333;
  font-weight: bold;
}

.input-group {
  background-color: #fff;
  border-radius: 10rpx;
  padding: 0 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
}

.input-item {
  display: flex;
  align-items: center;
  height: 100rpx;
  border-bottom: 1rpx solid #eee;
}

.input-item:last-child {
  border-bottom: none;
}

.icon {
  width: 40rpx;
  height: 40rpx;
  margin-right: 20rpx;
}

.input {
  flex: 1;
  font-size: 32rpx;
}

.placeholder {
  color: #ccc;
}

.code-btn {
  background-color: #00bfff;
  color: white;
  border-radius: 8rpx;
  font-size: 24rpx;
  height: 56rpx;
  line-height: 56rpx;
  padding: 0 20rpx;
  margin-left: 20rpx;
}

.code-btn::after {
  border: none;
}

.reset-btn {
  margin-top: 50rpx;
  background-color: #00bfff;
  color: white;
  border-radius: 50rpx;
  font-size: 36rpx;
  height: 90rpx;
  line-height: 90rpx;
  width: 100%;
}

.reset-btn::after {
  border: none;
}

.footer {
  display: flex;
  justify-content: center;
  margin-top: 30rpx;
}

.link {
  color: #00bfff;
  font-size: 28rpx;
}