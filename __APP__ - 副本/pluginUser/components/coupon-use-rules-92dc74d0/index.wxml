            <text class="text-24 text-primary" wx:if="{{__oc__.g( verifyData,['sellerName'] )}}">{{'\n          '+_i26+'：'+verifyData.sellerName+'\n        '}}</text>
            <text class="text-24 text-primary" wx:if="{{__oc__.g( verifyData,['multiStoreName'] )}}">{{'\n          '+_i27+'：'+verifyData.multiStoreName+'\n        '}}</text>
            <text class="text-24 text-primary" wx:if="{{__oc__.g( verifyData,['orderNo'] )}}">{{'\n          '+_i28+'：'+verifyData.orderNo+'\n        '}}</text>
