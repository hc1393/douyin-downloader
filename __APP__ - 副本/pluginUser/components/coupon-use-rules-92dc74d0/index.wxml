        <view bindtap="onSeeGoods" class="ml-6 text-_bl__h_666_br_ text-24 text-primary extend-click" wx:else>
            <text class="text-24 text-primary">{{_i11}}</text>
            <text class="i-arrow-r _i_text-20 _i_text-primary"></text>
