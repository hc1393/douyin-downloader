<view class="w-full px-24 box-border overflow-hidden {{show?'h-fit':'h-0'}}">
    <view class="flex mb-20" wx:if="{{isShowId}}">
        <text class="text-_bl__h_666_br_ font-500 text-24 whitespace-nowrap">{{_i1+'：'}}</text>
        <text class="text-_bl__h_666_br_ font-500 text-24">{{couponId}}</text>
        <view bindtap="onCopy" class="ml-6 text-_bl__h_666_br_ text-24 text-primary extend-click">{{_i2}}</view>
    </view>
    <view class="flex mb-20" wx:if="{{isShowBrand}}">
