.tui-scroll__view{border-bottom:1px solid #f3f3f3;height:80rpx;overflow:hidden;width:100%}.tui-tabs__fixed{left:0;position:fixed}.tui-tabs__sticky{left:0;position:-webkit-sticky;position:sticky}.tui-tabs__wrap{padding-bottom:20rpx}.tui-tabs__list{display:-webkit-flex;display:flex;height:80rpx;position:relative}.tui-tabs__scroll{display:block!important;white-space:nowrap!important}.tui-tabs__scroll .tui-tabs__item{display:-webkit-inline-flex;display:inline-flex;padding:0 30rpx}.tui-tabs__scroll .tui-item__child{display:block!important}.tui-tabs__item{align-items:center;box-sizing:border-box;display:-webkit-flex;display:flex;flex:1;justify-content:center;padding:0 10rpx;position:relative;text-align:center;transition:color .3s ease-in-out;z-index:2}.tui-item__child{display:inline-block;transform-origin:center center;transition:-webkit-transform .15s;transition:transform .15s;transition:transform .15s,-webkit-transform .15s}.tui-tabs__line{display:inline-block;left:0;position:absolute;width:0}.tui-tabs__line.tui-transition{transition:width .3s,-webkit-transform .3s;transition:width .3s,transform .3s;transition:width .3s,transform .3s,-webkit-transform .3s}