<view class="px-24 pt-24 box-border" style="{{config.style}}">
    <view class="rd-16 pb-16 bg-_bl__h_FFF_br_ overflow-hidden">
        <view bindtap="toSeeAll" class="w-full h-94 flex justify-between items-center px-24 box-border">
            <text class="text-32 text-_bl__h_3D3D3D_br_ lh-46 font-500">{{title}}</text>
            <view class="flex items-center">
                <text class="text-24 text-_bl__h_999_br_">{{_i1}}</text>
                <text class="i-arrow-r _i_text-24 _i_text-_bl__h_999_br_ ml-2"></text>
            </view>
        </view>
        <view class="grid gap-x-16 gap-y-40 grid-cols-4 py-16">
            <view bindtap="goLink" class="flex flex-col justify-center items-center" data-type="{{item.type}}" wx:for="{{orderList}}" wx:key="index">
                <view class="w-60 h-60 flex justify-center items-center">
                    <image lazyLoad class="w-50 h-50" mode="scaleToFill" src="{{__oss__.s(mpxExt,item.img,0)}}" wx:if="{{item.isCustomImg}}"></image>
                    <text class="{{' '+(item.icon==='i-design-store-order'?'i-design-store-order':'')+' '+(item.icon==='i-design-pay-order'?'i-design-pay-order':'')+' '+(item.icon==='i-design-gift-order'?'i-design-gift-order':'')+' '+(item.icon==='i-design-member-order'?'i-design-member-order':'')+' '+(item.icon==='i-design-voucher-order'?'i-design-voucher-order':'')+' '+(item.icon==='i-design-pin-coupon-order'?'i-design-pin-coupon-order':'')+' '+(item.icon==='i-design-integral-mall'?'i-design-integral-mall':'')+' _i_text-52 _i_text-_bl__h_333_br_ '}}" wx:else></text>
                </view>
                <text class="text-24 text-_bl__h_666_br_ lh-34 mt-12">{{item.des}}</text>
            </view>
        </view>
    </view>
</view>
<wxs module="__oss__" src="../../../wxs/oss28ac43a0.wxs"/>