<view class="w-140 relative h-fit flex flex-col justify-between items-center {{isLocked?'opacity-40':''}}">
    <image lazyLoad class="w-80 h-80" mode="scaleToFill" src="{{__oss__.s(mpxExt,src,0)}}" wx:if="{{src}}"></image>
    <view class="{{'flex justify-center items-center '+(iconHasBg?'w-60 h-60 rd-full overflow-hidden bg-_bl_rgba_pl_237_2c_240_2c_246_2c_0_d_6_pr__br_':'w-80 h-80')}}" wx:else>
        <text class=" {{icon=='i-equity'?'i-equity':''}} {{icon=='i-coupon3'?'i-coupon3':''}} {{icon=='i-design-multi-integral'?'i-design-multi-integral':''}} {{icon=='i-design-discount'?'i-design-discount':''}} {{icon=='i-design-value-add'?'i-design-value-add':''}} {{icon=='i-design-multi-exp'?'i-design-multi-exp':''}} {{icon=='i-design-free-delivery'?'i-design-free-delivery':''}} text-primary " style="{{iconStyle}}"></text>
    </view>
    <view class="absolute top-0 right-8 w-fit h-22 px-4 flex justify-center items-center lh-22 text-16 text-white rd-tl-10 rd-r-10" style="{{badgeStyle}}" wx:if="{{badge}}">×{{badge}}</view>
    <text class="mt-8 lh-32 text-center line-clamp-1" style="{{labelStyle}}">{{label}}</text>
</view>
