.dining-assistant-suspension{background:#fff;box-shadow:0rpx 16rpx 40rpx 0rpx rgba(0,0,0,.1);height:164rpx;transition:-webkit-transform .4s linear;transition:transform .4s linear;transition:transform .4s linear,-webkit-transform .4s linear;width:164rpx;z-index:25}.dining-assistant-suspension,.dining-assistant-suspension .content{animation-duration:.1s;animation-fill-mode:both;animation-timing-function:linear;border-radius:50%}.dining-assistant-suspension .content{height:148rpx;width:148rpx}.dining-assistant-suspension .content .more-order-line{margin:16rpx 0;position:relative;width:88rpx}.dining-assistant-suspension .content .more-order-line:after{border-bottom:1px solid #fff;box-sizing:border-box;content:"";height:200%;left:0;pointer-events:none;position:absolute;top:0;transform:scale(.5);transform-origin:0 0;width:200%}.dining-assistant-suspension .content .show-more-order-view{width:100%}.dining-assistant-suspension .content .show-more-order-view .show-more-order{font-size:24rpx}.dining-assistant-more{animation-name:order-expand}.dining-assistant-singl{animation-name:order-collapse}.dining-assistant-content-more{animation-name:order-expand-2}.dining-assistant-content-singl{animation-name:order-collapse-2}