<std-popup closeable lockScroll round bindclose="hide" position="bottom" show="{{isShowPayCom}}" title="备注">
    <view class="payChoose__body" style="padding-bottom: 130rpx">
        <view catchtouchmove="noop" class="m-24rpx rounded-_bl_8rpx_br_ w-686rpx relative" style="box-sizing: border-box;{{paddingBottom}} ">
            <textarea adjustPosition="{{false}}" bindblur="bindblur" bindinput="remarkInput" bindkeyboardheightchange="keyboardheightchange" catchtouchmove="noop" class="box-border w-_bl_100_p__br_ pt-18rpx pb-30rpx pl-18rpx pr-18rpx text-28rpx bg-_bl__h_f5f5f5_br_ border-rd-10rpx mt-34rpx" confirmHold="{{isShowPayCom}}" confirmType="done" holdKeyboard="{{isShowPayCom}}" maxlength="500" placeholder="{{configPlaceholder||placeholder}}" placeholderStyle="color: #999;" showConfirmBar="{{false}}" value="{{remarkData}}"></textarea>
            <view class="absolute bottom-6rpx right-6rpx text-24rpx text-_bl__h_999_br_" style="{{paddingBottom}}">{{characterCount||0}}/500</view>
        </view>
    </view>
    <view class="payChoose__foot">
        <view catchtap="submitRemark" class="h-90rpx mt-30rpx text-_bl__h_ffffff_br_ text-34rpx lh-90rpx text-center border-rd-44rpx fixed left-24rpx right-24rpx bottom-26rpx" style="background-color: {{colorTheme}};{{modalBottom}}">{{_i1}}</view>
    </view>
</std-popup>
