    </view>
    <view class="w-100_p_ h-16 bg-_h_F5F5F5"></view>
    <view catchtap="hideModal" class="w-_bl_100_p__br_ h-106rpx text-30rpx text-_bl__h_666666_br_ flex justify-center items-center">{{_i2}}</view>
</view>
