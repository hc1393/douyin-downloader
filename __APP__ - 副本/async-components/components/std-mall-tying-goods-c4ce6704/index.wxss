.tying-goods{background:var(--std-tying-color--1,linear-gradient(92deg,rgba(253,225,243,.3) 8%,rgba(253,229,236,.3) 39%,hsla(14,93%,95%,.3) 94%)
  );border-radius:8rpx;padding:20rpx}.tying-goods-header,.tying-goods-header__icon{align-items:center;display:-webkit-flex;display:flex}.tying-goods-header__icon{background:var(--std-tying-color,linear-gradient(90deg,#fd6449 0,#fa3423 100%));border-radius:8rpx;color:#fff;font-size:26rpx;font-weight:700;height:44rpx;justify-content:center;line-height:1em;margin-right:12rpx;width:44rpx}.tying-goods-header__title{color:#333;font-size:26rpx;font-weight:700}.tying-goods-content{display:-webkit-flex;display:flex;flex-wrap:wrap;margin:12rpx -8rpx -8rpx}.tying-goods-content__item{background-color:#fff;border-radius:8rpx;box-sizing:border-box;display:-webkit-flex;display:flex;flex:0 0 calc(50% - 8rpx*2);margin:8rpx;-webkit-mask:radial-gradient(circle at 0,transparent 8rpx,#fff 0),radial-gradient(circle at right,transparent 8rpx,#fff 0);-webkit-mask-composite:source-in;padding:16rpx 28rpx;position:relative}.tying-goods-content__item-name{color:#666;flex:1;font-size:24rpx;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;width:0}.tying-goods-content__item-label{background:var(--std-tying-color,linear-gradient(90deg,#fd6449 0,#fa3423 100%));border-radius:0 8rpx 0 8rpx;color:#fff;font-size:18rpx;line-height:1em;padding:2rpx 6rpx;position:absolute;right:0;top:0}.color-highlight{color:var(--std-tying-color,#fa3423)}