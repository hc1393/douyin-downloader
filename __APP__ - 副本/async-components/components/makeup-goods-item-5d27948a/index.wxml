<view class="relative px-24rpx mt-24 flex items-start {{modeLarge=='large'?'mode_large':''}}">
    <view class="w-120 h-120 rd-8">
        <image class="w-full h-full rd-8" lazyLoad="true" mode="aspectFill" src="{{__oss__.s(mpxExt,goods.pictureUrlList[0]?goods.pictureUrlList[0]:goodsDefaultImage,0)}}"></image>
    </view>
    <view class="flex flex-1 flex-col ml-24">
        <view class="text-30 lh-42 font-500">{{goods.name}}</view>
        <view class="w-500 text-24 lh-34 text-_h_999 h-34 overflow-hidden whitespace-nowrap text-ellipsis">{{goods.detail||''}}</view>
        <view class="flex items-center justify-between mt-8">
            <view>
                <text class="text-24">{{currencySymbol}}</text>
                <text class="text-36">{{goods.showPriceLow}}</text>
            </view>
            <view>
                <cart-control bindchange="cartGoodsChange" data-goods="{{goods}}" num="{{foodNum[goods.id]?foodNum[goods.id].num||0:0}}"></cart-control>
            </view>
        </view>
    </view>
</view>
<wxs module="__oss__" src="../../../wxs/oss28ac43a0.wxs"/>
<wxs module="tools" src="../../wxs/tools22b08362.wxs"/>