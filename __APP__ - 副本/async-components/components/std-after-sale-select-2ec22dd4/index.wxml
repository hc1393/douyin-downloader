<std-popup closeable round bind:close="onClose" position="bottom" show="{{show}}" title="{{title}}">
    <scroll-view enablePassive enhanced scrollY style="max-height: 60vh">
        <view class="mx-20 mb-48">
            <view class="bg-hex-fff rounded-24 bg-hex-fff rounded-24" wx:if="{{showAfterSaleType}}">
                <view bind:tap="onChangeType" class="flex items-center flex-wrap justify-start box-border py-38 pr-24 pl-33 relative" data-type="{{AfterSaleTypeEnum.Refund}}" wx:if="{{canRefundOnly}}">
                    <view class="text-primary text-44 mr-27 i-refund"></view>
                    <view class="flex-1">
                        <view class="text-hex-000 text-30 font-700 leading-42">我要退款（无需退货）</view>
                        <view class="text-hex-888 text-26 font-400 mt-4">未收到货，或与商家协商之后申请</view>
                    </view>
                    <std-checkbox value="{{refund}}"></std-checkbox>
                </view>
                <view bind:tap="onChangeType" class="flex items-center flex-wrap justify-start box-border py-38 pr-24 pl-33 relative border-t-1rpx border-t-solid border-t-hex-e5e5e5" data-type="{{AfterSaleTypeEnum.ReturnAndRefund}}" wx:if="{{canReturnAndRefund}}">
                    <view class="text-primary text-44 mr-27 i-rgoods"></view>
                    <view class="flex-1">
                        <view class="text-hex-000 text-30 font-700 leading-42">我要退款退货</view>
                        <view class="text-hex-888 text-26 font-400 mt-4">已收到货，需要退换已收到的货物</view>
                    </view>
                    <std-checkbox value="{{returnAndRefund}}"></std-checkbox>
                </view>
            </view>
            <block wx:if="{{goodsLevel}}">
                <view class="flex items-center text-hex-333 text-30 font-500 my-22" wx:if="{{showAfterSaleType}}">退款商品<view class="text-hex-f23">*</view>
                </view>
                <view class="bg-white rd-24">
                    <view class="p-24">
                        <std-brand-info></std-brand-info>
                    </view>
                    <view class="items-start flex py-24 pr-24 {{goods.selected?'bg-hex-f9f9f9':''}}" wx:for="{{itemListTmp}}" wx:for-item="goods" wx:key="itemId">
                        <view class="flex items-center justify-center h-220">
                            <view class="-mr10 p24 text-42 c-hex-c8c9cc {{goods.selected?'i-checked':'i-unchecked'}}" wx:if="{{goods.status===0}}"></view>
                            <view bindtap="onToggleSelect" class="-mr10 p24 text-42 {{goods.selected?'i-checked c-primary':'i-unchecked c-hex-c8c9cc'}}" data-index="{{index}}" wx:else></view>
                        </view>
                        <image lazyLoad class="bg-hex-d8d8d8 rounded-24 h-220 ml-12 mr-24 w-220" src="{{__oss__.s(mpxExt,goods.coverUrl,0)}}"></image>
                        <view class="flex-1">
                            <view class="flex-1 flex flex-col items-start min-h-220">
                                <view class="flex items-start justify-between w-full">
                                    <view class="text-hex-333 text-28 leading-40">{{goods.itemName}}</view>
                                </view>
                                <view class="flex items-start justify-between w-full">
                                    <view class="items-baseline text-hex-111 flex text-26 font-500">¥{{goods.salePrice}}<text wx:if="{{goods.pointsPrice}}"> + {{goods.pointsPrice}}{{customPointName}}</text>
                                    </view>
                                </view>
                                <view class="bg-hex-00000005 rounded-8 text-hex-888 text-26 leading-37 my-10 pl-12 py-6 relative {{goods.isMultiSpec?'pr-36':'pr-12'}}" wx:if="{{goods.specValueList}}">{{goods.specValueList}}<view class="absolute right-4 top-1_s_2 transform -translate-y-1_s_2 rotate-90 scale-50 i-arrow-r1" wx:if="{{goods.isMultiSpec}}"></view>
                                </view>
                                <std-tag plain class="mt-2" color="#fa3423" wx:if="{{goods.returnCashMoney}}">余额返{{goods.returnCashMoney}}元</std-tag>
                                <view class="flex-auto"></view>
                                <view class="items-center flex justify-between w-full">
                                    <view class="text-hex-111 text-26 font-700 leading-45">x{{goods.num}}</view>
                                    <std-stepper asyncChange disableInput bind:change="onChangeBuyNum" data-index="{{index}}" disabled="{{!allowChangeNum}}" max="{{goods.num}}" min="{{0}}" theme="border" value="{{goods.selectedNum}}"></std-stepper>
                                </view>
                            </view>
                        </view>
                    </view>
                </view>
            </block>
        </view>
    </scroll-view>
    <view class="bg-hex-fff p-24 relative z-10" style=" box-shadow: 0 0rpx 10rpx 0rpx rgba(0, 0, 0, 0.1); margin-bottom: calc(env(safe-area-inset-bottom) * -1 / 2); ">
        <button bindtap="onConfirm" class="button button-primary rd-full flex" disabled="{{disableConfirm}}">确定</button>
    </view>
</std-popup>
<wxs module="__oss__" src="../../../wxs/oss28ac43a0.wxs"/>