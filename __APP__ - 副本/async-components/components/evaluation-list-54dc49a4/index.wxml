<view class="px-32rpx py-1rpx">
    <view class="font-500 text-30rpx mx-0 my-40rpx">精选评价<text class="text-24rpx text-_bl__h_999999_br_ pl-10rpx">({{commentList.length}})</text>
    </view>
    <view>
        <view class="mx-0 my-30rpx" id="comment-{{item.id}}" wx:for="{{commentList}}" wx:key="id">
            <view class="flex items-center">
                <image class="w-64rpx h-64rpx border-rd-_bl_50_p__br_ bg-_bl__h_cccccc_br_" src="{{__oss__.s(mpxExt,item.userInfo.avatar||storeInfo.logo||'https://images.qmai.cn/s1001195/images/2021/04/07/453ae66bf1cc283f.png',0)}}"></image>
                <view class="flex-1 h-64rpx box-border px-24rpx py-0 flex flex-col justify-between">
                    <view class="text-26rpx font-500 text-_bl__h_333333_br_">{{item.userInfo.userName?tools.desensitationName(item.userInfo.userName):'匿名用户'}}</view>
                    <view class="flex items-center" style="color: {{colorTheme}};">
                        <text class="i-star text-24rpx mr-4rpx" wx:for="{{item.commentScore}}" wx:key="*this"></text>
                    </view>
                </view>
                <view bindtap="__invoke" class="flex items-center text-_bl__h_999999_br_" data-eventconfigs="{{ tap:[ ['like',item,index] ] }}" style="color: {{item.likesStatus==1?colorTheme:''}};">
                    <text class="i-dianzan-m1 text-32rpx"></text>
                    <text class="text-26rpx pl-4rpx" wx:if="{{item.likesCount>0}}">{{item.likesCount}}</text>
                </view>
            </view>
            <view class="w-_bl_100_p__br_ text-26rpx text-_bl__h_333333_br_ mx-0 my-24rpx">
                <clamp-fonts fonts="{{item.buyerRemarks}}"></clamp-fonts>
            </view>
            <view class="flex relative mx-0 my-24rpx" wx:if="{{item.commentImageList.length}}">
                <image bindtap="__invoke" class="w-214rpx h-214rpx bg-_bl__h_f5f5f5_br_ border-rd-8rpx mr-30rpx" data-eventconfigs="{{ tap:[ ['seePicDetail',picSrc,item.commentImageList] ] }}" mode="aspectFill" src="{{__oss__.s(mpxExt,picSrc,0)}}" wx:if="{{picIndex<3}}" wx:for="{{item.commentImageList}}" wx:for-index="picIndex" wx:for-item="picSrc" wx:key="*this"></image>
                <view class="px-12rpx py-0 h-38rpx bg-_bl_rgba_pl_0_2c_0_2c_0_2c_0_d_74_pr__br_ border-rd-19rpx text-24rpx text-_bl__h_ffffff_br_ absolute right-8rpx bottom-8rpx" wx:if="{{item.commentImageList.length>3}}">+{{item.commentImageList.length-3}}</view>
            </view>
            <view class="flex w-_bl_100_p__br_ p-20rpx mx-0 my-24rpx box-border bg-_bl__h_f5f5f5_br_ border-rd-8rpx" wx:if="{{item.props}}">
                <view class="w-0 flex-1 flex flex-col pr-20rpx box-border">
                    <view class="text-26rpx font-500 text-_bl__h_333333_br_ mb-10rpx">他的口味<text class="text-24rpx text-_bl__h_999999_br_ pl-10rpx" wx:if="{{item.buySameCount>0}}">{{item.buySameCount}}人加购</text>
                    </view>
                    <view class="w-_bl_100_p__br_ flex items-center text-24rpx text-_bl__h_999999_br_">
                        <clamp-fonts fonts="{{item.props}}" rows="{{1}}"></clamp-fonts>
                    </view>
                </view>
                <view bindtap="__invoke" class="flex items-center justify-center w-130rpx h-60rpx mt-10rpx border-rd-11rpx text-24rpx text-_bl__h_ffffff_br_" data-eventconfigs="{{ tap:[ ['clickSameKind',item.id] ] }}" style="background-color: {{colorTheme}};">点同款</view>
            </view>
        </view>
    </view>
</view>
<wxs module="__oss__" src="../../../wxs/oss28ac43a0.wxs"/>
<wxs module="tools" src="../../wxs/hide-phone-number23ee53a7.wxs"/>