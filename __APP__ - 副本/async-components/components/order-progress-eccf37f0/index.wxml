                <text style="color:{{colorTheme}}">{{sendHourMinute}}</text>
                <text>{{_i26}}</text>
            </block>
        </text>
    </block>
    <block wx:elif="{{queueShowContent==='cupAndTime'}}">
        <text wx:if="{{orderQueueInfo.cupNum==0}}">{{_i27}}</text>
        <text wx:if="{{orderQueueInfo.cupNum>0}}">
            <block wx:if="{{orderType!=3}}">
                <text>{{_i28}}</text>
                <text style="color:{{colorTheme}}">{{orderQueueInfo.cupNum}}</text>
                <text>{{orderQueueInfo.countUnit+_i29}}</text>
                <block wx:if="{{orderQueueInfo.makeTimeHour}}">
