                    <text>{{_i30}}</text>
                </block>
                <block wx:if="{{orderQueueInfo.makeTimeMinutes}}">
                    <text style="color:{{colorTheme}}">{{orderQueueInfo.makeTimeMinutes}}</text>
                    <text>{{_i31}}</text>
                </block>
            </block>
            <block wx:elif="{{deliveryTimeShow}}">
                <text>{{_i32}}</text>
                <text style="color:{{colorTheme}}">{{orderQueueInfo.cupNum}}</text>
                <text>{{orderQueueInfo.countUnit+_i33}}</text>
