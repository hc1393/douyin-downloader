.std-navigation-bar{box-sizing:initial;overflow:hidden;padding-top:var(--status-bar-height);position:relative}.std-navigation-bar--fixed{left:0;position:fixed;top:0;width:100%;z-index:999}.std-navigation-bar__body{-ms-flex-align:center;-ms-flex-pack:center;align-items:center;box-sizing:border-box;display:-ms-flexbox;display:-webkit-flex;display:flex;height:var(--nav-bar-height);justify-content:center;position:relative;text-align:center}.std-navigation-bar__left{border-radius:999rpx;display:-ms-inline-flexbox;display:-webkit-inline-flex;display:inline-flex;left:var(--nav-btn-left);position:absolute;top:var(--nav-btn-top);z-index:1}.std-navigation-bar__left:after{border:1px solid rgba(0,0,0,.05);border-radius:inherit;box-sizing:border-box;content:" ";display:none;height:200%;left:0;pointer-events:none;position:absolute;top:0;transform:scale(.5);transform-origin:0 0;width:200%}.std-navigation-bar__left.is-group{background-color:hsla(0,0%,100%,.6)}.std-navigation-bar__left.is-solid{border:1px solid #e5e5e5}.std-navigation-bar__title{font-size:34rpx;font-weight:500;max-width:340rpx;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.std-navigation-bar--black .std-navigation-bar__line{background:rgba(0,0,0,.15)}.std-navigation-bar--white .std-navigation-icon{background:rgba(0,0,0,.17);color:#fff}.std-navigation-bar__line{left:50%;position:absolute;top:50%;transform:scaleX(.5) translate(-50%,-50%);width:1px}.std-navigation-icon{-ms-flex-align:center;-ms-flex-pack:center;align-items:center;display:-ms-flexbox;display:-webkit-flex;display:flex;justify-content:center}