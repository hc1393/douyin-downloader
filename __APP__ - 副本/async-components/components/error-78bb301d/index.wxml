        <view class="w-380rpx h-260rpx">
            <image class="w-_bl_100_p__br_ h-_bl_100_p__br_" lazyLoad="true" mode="widthFix" src="{{__oss__.s(mpxExt,errorImage||'https://img-shop.qmimg.cn/s16/images/2021/07/02/d0b344e032194c0e.png?x-oss-process=image/resize,w_100',0)}}"></image>
