.std-checkbox{-ms-flex-align:center;align-items:center;display:-ms-flexbox;display:-webkit-flex;display:flex;overflow:hidden;user-select:none}.std-checkbox--horizontal{margin-right:48rpx}.std-checkbox__icon-wrap,.std-checkbox__label{line-height:var(--checkbox-size,40rpx)}.std-checkbox__icon-wrap{flex:none}.std-checkbox__icon{-ms-flex-align:center;-ms-flex-pack:center;align-items:center;border:1px solid var(--checkbox-border-color,#c8c9cc);box-sizing:border-box;color:transparent;display:-ms-flexbox;display:-webkit-flex;display:flex;font-size:var(--checkbox-size,40rpx);height:1em;justify-content:center;text-align:center;transition-duration:var(--checkbox-transition-duration,.2s);transition-property:color,border-color,background-color;width:1em}.std-checkbox__icon--round{border-radius:100%}.std-checkbox__icon--checked{background-color:var(--std-primary-color,#ff5a00);border-color:var(--std-primary-color,#ff5a00);color:#fff}.std-checkbox__icon--disabled{background-color:var(--checkbox-disabled-background-color,#c8c9cc);border-color:var(--checkbox-disabled-icon-color,#c8c9cc)}.std-checkbox__label{word-wrap:break-word;color:var(--checkbox-label-color,#333);padding-left:12rpx}.std-checkbox__label--left{float:left;margin:0 20rpx 0 0}.std-checkbox__label--disabled{color:var(--checkbox-disabled-label-color,#c8c9cc)}.std-checkbox__label:empty{margin:0}