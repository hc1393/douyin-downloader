.std-matchgoods{background:linear-gradient(var(--light-theme-color),#fff);background:-webkit-linear-gradient(var(--light-theme-color),#fff);border-radius:10rpx 10rpx 0rpx 0rpx;box-sizing:border-box;padding:24rpx 0;width:100%}.std-matchgoods__header{-ms-flex-align:center;align-items:center;box-sizing:border-box;display:-ms-flexbox;display:-webkit-flex;display:flex;margin-bottom:24rpx;padding:0 24rpx;width:100%}.std-matchgoods__icon{color:var(--theme-color);font-size:40rpx}.std-matchgoods__img-icon{height:40rpx;width:40rpx}.std-matchgoods__title{color:#333;font-size:30rpx;font-weight:500;line-height:42rpx;padding:0 8rpx}.std-matchgoods__desc{color:#999;flex:1;font-size:24rpx;font-weight:400;line-height:34rpx;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;width:0}.std-matchgoods__row-body{width:100%}.std-matchgoods__row-items{box-sizing:border-box;display:-ms-flexbox;display:-webkit-flex;display:flex;flex-wrap:nowrap;padding-left:24rpx;width:-moz-fit-content;width:-webkit-fit-content;width:fit-content}.std-matchgoods__row-item{--item-width:170rpx;display:inline-block;margin-right:24rpx;width:var(--item-width)}.std-matchgoods__img-box{border-radius:8rpx 8rpx 8rpx 8rpx;height:var(--item-width);overflow:hidden;width:var(--item-width)}.std-matchgoods__img{height:100%;width:100%}.std-matchgoods__name{color:#333;font-weight:500;line-height:34rpx;margin-top:8rpx}.std-matchgoods__name,.std-matchgoods__words{font-size:24rpx;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.std-matchgoods__words{color:#999;font-weight:400;height:30rpx;line-height:30rpx}.std-matchgoods__theme-font{color:var(--theme-color);padding:0 10rpx}.std-matchgoods__bottom{-ms-flex-align:center;-ms-flex-pack:justify;align-items:center;display:-ms-flexbox;display:-webkit-flex;display:flex;justify-content:space-between}.std-matchgoods__price{color:#f93a4a;font-size:24rpx;font-weight:500;line-height:34rpx}.std-matchgoods__operate{-ms-flex-align:center;-ms-flex-pack:justify;align-items:center;display:-ms-flexbox;display:-webkit-flex;display:flex;justify-content:space-between;position:relative}.std-matchgoods__num{--cWidth:28rpx;background-color:var(--theme-color);border:2rpx solid #fff;border-radius:20rpx;color:#fff;font-size:22rpx;height:var(--cWidth);line-height:var(--cWidth);min-width:var(--cWidth);position:absolute;right:-10rpx;text-align:center;top:-15rpx}.std-matchgoods__plus-btn{color:var(--theme-color);font-size:36rpx}.std-matchgoods__column-item{display:-ms-flexbox;display:-webkit-flex;display:flex;margin-bottom:24rpx;margin-left:24rpx;margin-right:24rpx}.std-matchgoods__smaller-img-box{border-radius:8rpx 8rpx 8rpx 8rpx;height:120rpx;overflow:hidden;width:120rpx}.std-matchgoods__right{flex:1;margin-left:16rpx;width:0}.std-matchgoods__goods-num{color:#333;font-size:26rpx;font-style:normal;font-weight:400;height:36rpx;line-height:36rpx;text-align:center;text-transform:none;width:45rpx}.std-matchgoods__show-btn{-ms-flex-align:center;-ms-flex-pack:center;align-items:center;display:-ms-flexbox;display:-webkit-flex;display:flex;justify-content:center;margin-bottom:24rpx}.std-matchgoods__show-font{color:#666;font-size:26rpx;font-style:normal;font-weight:400;line-height:32rpx;padding-right:10rpx;text-align:center;text-transform:none}.std-matchgoods__show-arrow{color:#666;font-size:24rpx}.mt-20{margin-top:20rpx}.mt-0{margin-top:0}