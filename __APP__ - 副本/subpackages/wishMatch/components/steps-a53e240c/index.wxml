<view class="fixed left-0 z-4 flex items-center box-border w-_bl_100_p__br_ h-200rpx px-24rpx py-0 bg-_bl__h_ffffff_br_ border-rd-_bl_0_0_20rpx_20rpx_br_ shadow-_bl_0_0_6rpx_0_rgba_pl_0_2c_0_2c_0_2c_0_d_05_pr__br_" style="top: {{navbarHeight}}px;{{multiSpecsShow?'height:338rpx;flex-direction: column;':''}}">
