            <view class="{{' absolute top-_bl_50_p__br_ left-_bl_50_p__br_ flex items-center justify-center w-50rpx h-50rpx overflow-hidden border-rd-_bl_50_p__br_ translate-_bl_-50_p__2c_-50_p__br_ transition-opacity transition-duration-0_d_3s transition-ease-_bl_ease_br_ transition-delay-0_d_2s '+(index<step?'op-100':'op-0')+' '}}">
                <image class="w-50rpx h-50rpx border-rd-_bl_50_p__br_" lazyLoad="true" src="{{__oss__.s(mpxExt,designConfig.stepIcon,0)}}"></image>
