        <view>
            <view class="px-0 pt-28rpx pb-4rpx text-_bl__h_666_br_ text-24rpx">{{selectedSpecName}}</view>
            <view class="flex flex-nowrap overflow-x-scroll">
                <block wx:for="{{goodsSkuList}}" wx:for-item="goodsSkuItem" wx:key="*this">
