<template name="food-price-container">
    <view class="food-price" wx:if="{{food.pointsInfo}}">{{food.pointsInfo.points}}<text class="food-price_unit">{{pointName}}</text>
        <block wx:if="{{food.pointsInfo.price}}">
            <text class="food-price_unit-add"> + </text>
            <text class="food-price_unit">{{currencySymbol}}</text>{{descSubstring.toNumber(food.pointsInfo.price)}}</block>
    </view>
    <block wx:else>
        <view class="food-price" wx:if="{{food.type!=10||food.type==10&&food.showPriceLow>0}}">
            <text class="food-price_unit">{{currencySymbol}}</text>
            <block wx:if="{{food.discountPrice}}">
                <block wx:if="{{food.skuIdList.length===1}}">{{food.discountPrice}}</block>
                <block wx:if="{{food.skuIdList.length>1}}">
                    <block wx:if="{{food.discountPrice<food.showPriceLow}}">{{food.discountPrice}}</block>
                    <block wx:else>{{food.showPriceLow}}</block>
                </block>
            </block>
            <block wx:else>{{food.showPriceLow}}</block>
            <text class="unit-text" wx:if="{{food.unit_type}}">/{{food.unit}}</text>
        </view>
        <view class="food-origin-price">
            <view class="food-original-price-wrapper">
                <view class="add-price-sign" wx:if="{{food.isAdd}}">{{_i1}}</view>
                <view class="cart-bar_origin_price" wx:if="{{food.discountPrice&&(food.skuIdList.length===1||food.discountPrice<food.showPriceLow)&&!(food.type==3&&food.packCoverUrl)}}">{{currencySymbol+food.showPriceLow}}</view>
            </view>
        </view>
    </block>
    <text class="iconfont i-jiantou-you" wx:if="{{!food.disabled&&!isErrorStatus&&food.type!=10&&(food.controlType=='popover'||food.controlType=='meal')}}"></text>
</template>
<wxs module="descSubstring" src="../wxs/goods-desc-substring19cd8500.wxs"/>