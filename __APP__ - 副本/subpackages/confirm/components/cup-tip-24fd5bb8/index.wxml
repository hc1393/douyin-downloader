<view catchtouchmove="noop" style="{{propShow?'':'display:none;'}}">
    <view catchtap="hidePopup" class="fixed top-0 right-0 bottom-0 left-0 z-1000 bg-_bl_rgba_pl_0_2c_0_2c_0_2c_0_d_6_pr__br_"></view>
    <view catchtouchmove="noop" class="fixed right-0 bottom-0 left-0 z-10001 overflow-hidden bg-_bl__h_fff_br_ border-rd-_bl_30rpx_30rpx_0_0_br_ px-32rpx pt-26rpx pb-0 pb-_bl_calc_pl_30rpx_a_constant_pl_safe-area-inset-bottom_pr__pr__br_ pb-_bl_calc_pl_30rpx_a_env_pl_safe-area-inset-bottom_pr__pr__br_" style="min-height: 568rpx;box-sizing: border-box;{{paddingBottom}}">
        <view catchtap="hidePopup" class="i-close px-24rpx py-18rpx absolute top-0 right-0 text-_bl__h_999_br_ text-40rpx"></view>
        <view class="text-center text-36rpx font-bold">编辑杯贴留言</view>
        <view catchtouchmove="noop" class="w-686rpx" style="{{keyboardIsShow?'margin-bottom:130rpx':''}}">
            <textarea adjustPosition="{{false}}" bindblur="bindblur" bindfocus="areaFocu" bindinput="areaInput" bindkeyboardheightchange="keyboardheightchange" catchtouchmove="noop" class="box-border w-_bl_100_p__br_ h-180rpx pt-18rpx pb-30rpx pl-18rpx pr-18rpx text-26rpx bg-_bl__h_f5f5f5_br_ border-rd-10rpx mt-34rpx" confirmHold="{{propShow}}" confirmType="done" holdKeyboard="{{propShow}}" maxlength="20" placeholder="这句祝福会被打在杯帖上" placeholderStyle="color: #999;" showConfirmBar="{{false}}" value="{{imputMsg}}"></textarea>
        </view>
        <view catchtap="commitMsg" class="h-90rpx mt-30rpx text-_bl__h_ffffff_br_ text-34rpx lh-90rpx text-center border-rd-44rpx fixed left-24rpx right-24rpx bottom-26rpx" style="background-color: {{colorTheme||'#F2B940'}};{{modalBottom}}">确定</view>
    </view>
</view>
