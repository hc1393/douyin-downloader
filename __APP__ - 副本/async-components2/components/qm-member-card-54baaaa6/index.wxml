<view bindtap="linkUserRights" style="{{info.miniStyle}}; background-image: url({{cardBgImg||visitorImg}});{{visitorImg?'height:115px;':''}}" wx:if="{{hasShow}}">
    <view class="flex box-border w-_bl_100_p__br_ px-24rpx py-20rpx">
        <view class="flex flex-1 flex-col justify-between" wx:if="{{isAuth}}">
            <view class="flex items-center">
                <image class="w-21rpx h-21rpx mr-10rpx" src="{{__oss__.s(mpxExt,info.propsValue.titleIcon||'https://images.qmai.cn/resource/20210824210816/2022/07/21/qm-member-card-icon.png',0)}}"></image>
                <text class="text-_bl__h_000_br_ text-24rpx" style="color: {{info.propsValue.titleColor}};">{{info.propsValue.title||'会员权益'}}</text>
            </view>
            <view>
                <view class="pb-10rpx text-_bl__h_000_br_ text-28rpx" style="color: {{info.propsValue.levels[userAssets.levelInfo.level].cardTitleColor}};">{{info.propsValue.levels[userAssets.levelInfo.level].cardTitle||userAssets.levelInfo.cardName}}</view>
                <view class="relative w-287rpx h-6rpx bg-_bl__h_adadad_br_ border-rd-3rpx">
                    <view class="absolute top-0 left-0 w-0 h-6rpx border-rd-3rpx transition-all transition-duration-0_d_3s" style="width: {{userAssets.levelInfo.percent}}%; background-color: {{colorTheme}};"></view>
                </view>
                <view class="pb-10rpx text-_bl__h_606060_br_ text-20rpx">再获得{{userAssets.levelInfo.needValue}}{{userAssets.levelInfo.experienceName||'成长值'}}可升级</view>
            </view>
        </view>
        <image class="w-280rpx h-190rpx ml-24rpx" src="{{__oss__.s(mpxExt,info.propsValue.levels[userAssets.levelInfo.level].cardImg||userAssets.levelInfo.cardUrl,0)}}" wx:if="{{isAuth}}"></image>
    </view>
</view>
<wxs module="__oss__" src="../../../wxs/oss28ac43a0.wxs"/>