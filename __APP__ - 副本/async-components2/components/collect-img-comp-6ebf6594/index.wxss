.collect-img{background:var(--std-comp-bg-color,linear-gradient(180deg,#fff2e5 0,#fff 100%))}.collect-img-wrapper{background:#fff;border-radius:20rpx;overflow:hidden}.collect-img-header{align-items:flex-end;display:-webkit-flex;display:flex;justify-content:center;line-height:44rpx;padding:32rpx 32rpx 20rpx}.collect-img-header__title{color:var(--std-comp-title-color,#333);font-size:32rpx;font-weight:600}.collect-img-header__step{color:var(--std-comp-theme-color,#f68e20);font-size:32rpx;font-weight:600;margin-left:8rpx}.collect-img-header__plac{flex:1 1 auto}.collect-img-header__right{align-items:center;color:var(--std-comp-btn-color,#999);display:-webkit-flex;display:flex;font-size:26rpx;justify-content:center;line-height:40rpx;margin:-12rpx;padding:12rpx;text-align:right}.collect-img-album__target{padding:12rpx 0 36rpx 32rpx}.collect-img-album__body{align-items:center;display:-webkit-flex;display:flex;flex-wrap:nowrap;justify-content:flex-start}.collect-img-album__item{padding-right:18rpx}