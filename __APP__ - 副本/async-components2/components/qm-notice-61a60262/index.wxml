<view class="w-_bl_100_p__br_ h-60rpx relative overflow-hidden flex items-center" style="{{proper&&proper.miniStyle}};background-color:{{proper.propsValue&&proper.propsValue.backgroundColor}}" wx:if="{{hasShow}}">
    <view class="w-60rpx h-60rpx flex items-center justify-center">
        <image class="w-36rpx h-36rpx" src="{{__oss__.s(mpxExt,proper.propsValue.icon,0)}}" wx:if="{{proper.propsValue.icon}}"></image>
        <text class="i-notice text-32rpx" wx:else></text>
    </view>
    <view class="flex-1 w-0 overflow-hidden">
        <view class="flex items-center w-fit h-_bl_100_p__br_ z-0" style="{{animationStyle}}" wx:if="{{scrollType==1}}">
            <view class="text-inherit text-28rpx whitespace-nowrap flex JS-notice-bar-font">
                <block wx:if="{{hasShowNotice}}" wx:for="{{textList}}" wx:key="item">
                    <view style="color:{{noticeTextColor}};">{{item.text}}</view>
                    <view style="width:{{whiteContainerWidth}}px;"></view>
                </block>
                <view class="flex items-start" style="color:{{integralTextColor}};" wx:if="{{integralTipsText}}">
                    <view>{{integralTipsText}}</view>
                </view>
                <view style="width:{{whiteContainerWidth}}px" wx:if="{{integralTipsText}}"></view>
            </view>
            <view class="text-inherit text-28rpx whitespace-nowrap flex" wx:if="{{isOutside}}">
                <block wx:if="{{hasShowNotice}}" wx:for="{{textList}}" wx:key="item">
                    <view style="color:{{proper.propsValue.color}};">{{item.text}}</view>
                    <view style="width:{{whiteContainerWidth}}px;"></view>
                </block>
                <view class="flex items-start" style="color:{{integralTextColor}};" wx:if="{{integralTipsText}}">
                    <view>{{integralTipsText}}</view>
                </view>
                <view style="width:{{whiteContainerWidth}}px" wx:if="{{integralTipsText}}"></view>
            </view>
        </view>
        <view class="flex items-center w-fit h-_bl_100_p__br_ z-0 justify-center" wx:else>
            <view class="w-_bl_100_p__br_ h-60rpx overflow-hidden">
                <view class="flex flex-col w-_bl_100_p__br_ h-fit" style="{{animationStyle}}">
                    <view class="flex flex-col w-_bl_100_p__br_ lh-60rpx JS-notice-bar">
                        <block wx:if="{{hasShowNotice}}" wx:for="{{textList}}" wx:key="item">
                            <view class="flex w-_bl_100_p__br_ break-all" style="color:{{noticeTextColor}};">{{item.text}}</view>
                            <view class="w-_bl_100_p__br_ h-40rpx"></view>
                        </block>
                        <view class="break-all flex items-start" style="color:{{integralTextColor}};" wx:if="{{integralTipsText}}">
                            <view>{{integralTipsText}}</view>
                        </view>
                        <view class="w-_bl_100_p__br_ h-40rpx" wx:if="{{integralTipsText}}"></view>
                    </view>
                    <view class="flex flex-col w-_bl_100_p__br_ lh-60rpx JS-notice-bar" wx:if="{{isOutside}}">
                        <block wx:if="{{hasShowNotice}}" wx:for="{{textList}}" wx:key="item">
                            <view class="flex w-_bl_100_p__br_ break-all" style="color:{{noticeTextColor}};">{{item.text}}</view>
                            <view class="w-_bl_100_p__br_ h-40rpx"></view>
                        </block>
                        <view class="break-all flex items-start" style="color:{{integralTextColor}};" wx:if="{{integralTipsText}}">
                            <view>{{integralTipsText}}</view>
                        </view>
                        <view class="w-_bl_100_p__br_ h-40rpx" wx:if="{{integralTipsText}}"></view>
                    </view>
                </view>
            </view>
        </view>
    </view>
</view>
